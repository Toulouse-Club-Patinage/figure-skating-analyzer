# Routage de bordure. Un bloc par application.
#
# Chaque application garde SES propres règles (SPA, cache, fallback) dans
# son propre dépôt : ici on ne fait que du routage par domaine + TLS.

{
	email {$TLS_EMAIL}
}

# --- Ligue (gestion des compétitions) ---------------------------------
{$LIGUE_DOMAIN} {
	encode gzip

	handle /api/* {
		# La « zone de danger » de Ligue accepte des archives de
		# restauration d'environ 100 Mo. Cette limite DOIT être répétée
		# ici : le socle coupe le corps de la requête avant qu'il
		# n'atteigne le Caddy interne de l'app, qui a la même règle.
		request_body {
			max_size 110MB
		}
		reverse_proxy ligue-caddy:80
	}

	handle {
		reverse_proxy ligue-caddy:80
	}
}

# --- Ligue — ancien domaine, redirection ------------------------------
# L'app a changé de domaine (toulouseclubpatinage.com → ligue-occitanie-sg.com).
# Des liens vers l'ancien nom circulent dans les mails déjà envoyés aux clubs
# et dans les favoris : on les redirige plutôt que de les laisser tomber sur
# une erreur de certificat.
#
# `permanent` = 301 : les navigateurs la mettent en cache durablement. C'est
# voulu ici (le changement est définitif), mais cela signifie qu'un retour en
# arrière ne serait PAS vu par les clients qui ont déjà suivi la redirection.
#
# ⚠️ Caddy REFUSE de démarrer sur une adresse de site vide : le jour où l'on
# retire l'ancien domaine, commenter ce bloc ENTIER, ne pas se contenter de
# vider `LIGUE_DOMAIN_OLD` dans le `.env` — cela mettrait tout le routeur de
# bordure à terre, SkateLab compris.
{$LIGUE_DOMAIN_OLD} {
	redir https://{$LIGUE_DOMAIN}{uri} permanent
}

# --- SkateLab — INACTIF -----------------------------------------------
# L'application est encore servie par GCP ; elle n'est pas déployée sur ce
# VPS. Laisser ce bloc actif ferait tenter à Caddy une émission ACME pour
# un domaine qu'il ne sert pas, consommant le quota Let's Encrypt
# (5 échecs par domaine et par heure).
# Décommenter au moment de la bascule GCP → VPS.
#
